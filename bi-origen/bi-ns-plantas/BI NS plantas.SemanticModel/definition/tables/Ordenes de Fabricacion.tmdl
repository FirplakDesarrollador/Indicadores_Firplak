	column U_TipoPedidos
		dataType: string
		lineageTag: f9dff3a8-4442-49e5-ac30-3e51b5a70e9a
		summarizeBy: none
		sourceColumn: U_TipoPedidos

		annotation SummarizationSetBy = Automatic

	column 'Familia Producción (grupos)' =
			SWITCH(
			  TRUE,
			  ISBLANK('Ordenes de Fabricacion'[Familia Producción]),
			  "(En blanco)",
			  'Ordenes de Fabricacion'[Familia Producción] IN {"FV",
			    "FVH",
			    "FVHM",
			    "FVHMP",
			    "FVHMPM",
			    "FVM"},
			  "FIBRA",
			  'Ordenes de Fabricacion'[Familia Producción] IN {"PA",
			    "PAM",
			    "PC",
			    "PCM"},
			  "MARMOL",
			  'Ordenes de Fabricacion'[Familia Producción] IN {"MBL",
			    "MBLM",
			    "PTTM"},
			  "MUEBLE",
			  'Ordenes de Fabricacion'[Familia Producción] IN {"RTM",
			    "RTMM"},
			  "RTM",
			  'Ordenes de Fabricacion'[Familia Producción]
			)
		lineageTag: 81aecb59-cc24-40e2-9cdc-b89eb7214930
		summarizeBy: none

