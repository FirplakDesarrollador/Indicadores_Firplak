	partition 'Ordenes de Fabricacion-277e16d3-f12f-4eaf-8300-0a58f75daa0a' = m
		mode: import
		source =
				let
				    Origen = Sql.Database("Itplakinfo", "Firplak_SA", [Query="SELECT #(lf)    T0.CreateDate 'Fecha de Creación',#(lf)    T0.DocNum '# Documento',#(lf)    T0.ItemCode 'Cod Artículo',#(lf)    T0.ProdName 'Artículo',#(lf)    CONVERT(NUMERIC(18,0), T0.PlannedQty) 'Cantidad Planeada',#(lf)    T0.U_Tipo_Orden 'Tipo Orden',#(lf)    T0.RlsDate 'Fecha Real de Liberación',#(lf)    T0.CloseDate 'Fecha de Cierre Real',#(lf)    T3.U_FIR_FAM 'Familia Producción',#(lf)    CASE#(lf)        When T0.Status = 'R' then 'Liberado'#(lf)        When T0.Status = 'P' then 'Planificado'#(lf)        When T0.Status = 'L' then 'Cerrado'#(lf)    END 'Estado Orden',#(lf)    T0.U_U_Razonderetraso 'Razón de Retrazo',#(lf)    T0.U_U_Razonderetraso2 'Razón de Retrazo 2',#(lf)    convert(numeric(2,0), T4.U_Amortiguador) 'Amortiguador',#(lf)    CASE #(lf)        WHEN T4.U_Amortiguador = 1 THEN T0.RlsDate#(lf)        ELSE #(lf)            DATEADD(DAY, #(lf)                (#(lf)                    SELECT TOP 1 numeros.n#(lf)                    FROM (#(lf)                        SELECT n, #(lf)                               n + 1 - #(lf)                               (SELECT COUNT(1) #(lf)                                FROM [Firplak_SA].[dbo].[@FIR_FECHAS_PROD] fp #(lf)                                WHERE fp.U_Fecha BETWEEN DATEADD(DAY, 1, T0.RlsDate) #(lf)                                    AND DATEADD(DAY, n, T0.RlsDate)#(lf)                                    -- Agregamos filtro de fecha máxima para optimizar#(lf)                                    AND fp.U_Fecha <= DATEADD(DAY, T4.U_Amortiguador * 3, T0.RlsDate)#(lf)                               ) as dias_habiles#(lf)                        FROM (#(lf)                            -- Reducimos a un máximo de días más realista#(lf)                            SELECT TOP 30 ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n#(lf)                            FROM (VALUES (1),(1),(1),(1),(1)) t1(n)#(lf)                            CROSS JOIN (VALUES (1),(1),(1),(1),(1),(1)) t2(n)#(lf)                        ) AS nums#(lf)                        -- Agregamos filtro para reducir el conjunto de datos#(lf)                        WHERE n <= T4.U_Amortiguador * 3#(lf)                    ) AS numeros#(lf)                    WHERE numeros.dias_habiles = T4.U_Amortiguador#(lf)                    ORDER BY numeros.n#(lf)                ), #(lf)                T0.RlsDate#(lf)            )#(lf)    END as 'Fecha ideal Entrega',#(lf)    t2.U_TipoPedidos#(lf)FROM #(lf)    OWOR t0 #(lf)    INNER JOIN oitm t1 ON t0.ItemCode = t1.ItemCode #(lf)    INNER JOIN [Firplak_SA].[dbo].[ORDR] T2 ON T0.OriginNum = T2.DocNum#(lf)    INNER JOIN [Firplak_SA].[dbo].[@FIR_FAM_SYMPH] T3 ON t1.U_Familia = t3.U_FIR_FAM_MAES #(lf)        AND t3.U_FIR_TIPO_PED = T2.U_TipoPedidos#(lf)    INNER JOIN [Firplak_SA].[dbo].[@FIR_AMORTIGUADORES] T4 ON t3.U_FIR_FAM = T4.Name#(lf)    Collate SQL_Latin1_General_CP1_CI_AS#(lf)WHERE #(lf)    T0.CreateDate >= DATEADD(YEAR, -1, GETDATE())#(lf)    AND T0.RlsDate is not null#(lf)    AND T0.Status not in ('C','P')#(lf)    AND T0.U_NumLote <> ''#(lf)    AND T0.Warehouse in ('PT-01','PT-02','PT-08')#(lf)ORDER BY#(lf)    T0.DocNum DESC;"]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Fecha de Creación", type date}, {"# Documento", type text}, {"Fecha Real de Liberación", type date}, {"Fecha de Cierre Real", type date}})
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

