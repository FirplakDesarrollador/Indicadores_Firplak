	column Cumplio = ```
			IF('Ordenes de Fabricacion'[Fecha de Cierre Real 2]>'Ordenes de Fabricacion'[Fecha ideal Entrega], "INCUMPLIÓ", 
			                IF(ISBLANK('Ordenes de Fabricacion'[Fecha de Cierre Real 2])&&'Ordenes de Fabricacion'[Fecha ideal Entrega]<TODAY(), "INCUMPLIÓ", 
			                    IF(ISBLANK('Ordenes de Fabricacion'[Fecha de Cierre Real 2])&&'Ordenes de Fabricacion'[Fecha ideal Entrega]>=TODAY(),"","CUMPLIÓ")))
			```
		lineageTag: 62d25c0b-c87e-4e43-a4e9-988a3172f0e8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Semana = WEEKDAY('Ordenes de Fabricacion'[Fecha de Cierre Real])
		formatString: 0
		lineageTag: 9cfb1d88-97f5-4d4b-b859-0ac4cf374502
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Fecha de Cierre Real 2' = IF('Ordenes de Fabricacion'[Semana] = 7, 'Ordenes de Fabricacion'[Fecha de Cierre Real]-1,'Ordenes de Fabricacion'[Fecha de Cierre Real])
		formatString: General Date
