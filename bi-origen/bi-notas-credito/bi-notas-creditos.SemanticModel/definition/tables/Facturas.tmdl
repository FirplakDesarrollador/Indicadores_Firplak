	column 'Segmento del cliente'
		dataType: string
		lineageTag: abd89de5-2a7f-4e79-91e9-ffae9ac09221
		summarizeBy: none
		sourceColumn: Segmento del cliente

		annotation SummarizationSetBy = Automatic

	partition Facturas = m
		mode: import
		source =
				let
				    Source = Sql.Database("ITPLAKINFO", "Firplak_SA", [Query="SELECT T0.DOCDATE#(lf)      , T0.DOCNUM#(lf)      , CASE#(lf)           WHEN ISNULL(DATALENGTH(T1.U_TIENDAS),0) = 0 THEN T11.SLPNAME#(lf)           ELSE( #(lf)                 SELECT VENDEDOR.SLPNAME#(lf)     FROM OSLP VENDEDOR#(lf)          INNER JOIN OCRD SN ON SN.SLPCODE = VENDEDOR.SLPCODE#(lf)     WHERE SN.CARDCODE = T1.U_TIENDAS#(lf)               )#(lf)       END AS 'Vendedor Senior'#(lf)      , CASE#(lf)           WHEN ISNULL(DATALENGTH(T1.U_TIENDAS),0) = 0 THEN T12.NAME#(lf)           ELSE( #(lf)                 SELECT DISTINCT T16.NAME#(lf)     FROM [@FIR_VENDEDORJUNIOR] T16#(lf)          INNER JOIN OCRD T17 ON T17.U_VENDEDORJUNIOR = T16.CODE#(lf)     WHERE T17.CARDCODE = T1.U_TIENDAS#(lf)               )#(lf)       END AS 'Vendedor Junior'#(lf)      , T0.U_TipoVentas#(lf)      , CASE#(lf)           WHEN ISNULL(DATALENGTH(T1.U_TIENDAS),0) = 0 THEN T10.DESCRIPT#(lf)           ELSE( #(lf)                 SELECT ZONAPADRE.DESCRIPT#(lf)     FROM OCRD ZONASN#(lf)          INNER JOIN OTER ZONATERRITORIO ON ZONASN.TERRITORY = ZONATERRITORIO.TERRITRYID#(lf)          INNER JOIN OTER ZONAPADRE ON ZONATERRITORIO.PARENT = ZONAPADRE.TERRITRYID#(lf)     WHERE ZONASN.CARDCODE = T1.U_TIENDAS#(lf)               )#(lf)       END AS 'Zona'#(lf)      , CASE#(lf)           WHEN ISNULL(DATALENGTH(T1.U_TIENDAS),0) = 0 THEN T9.DESCRIPT#(lf)           ELSE( #(lf)                 SELECT ZONATERRITORIO.DESCRIPT#(lf)     FROM OCRD ZONASN#(lf)          INNER JOIN OTER ZONATERRITORIO ON ZONASN.TERRITORY = ZONATERRITORIO.TERRITRYID#(lf)     WHERE ZONASN.CARDCODE = T1.U_TIENDAS#(lf)               )#(lf)       END AS 'Territorio'#(lf)      , T5.GROUPNAME 'Grupo de Cliente'#(lf)      , T8.NAME 'Subgrupo de Cliente'#(lf)      , T0.CARDCODE 'Cod Cliente'#(lf)      , T0.CARDNAME 'Nombre Cliente'#(lf)      , T1.U_TIENDAS 'Código Punto de Venta'#(lf)      , T13.CARDNAME 'Descripción Punto de Venta'#(lf)      , CASE#(lf)           WHEN ISNULL(DATALENGTH(T1.U_TIENDAS),0) = 0 THEN T4.U_CENTRODECTOS#(lf)           ELSE T13.U_CENTRODECTOS#(lf)       END AS 'Centro de Costos'#(lf)      , T15.ITMSGRPNAM 'Grupo de Articulo'#(lf)      , T14.U_GRUPO 'Familia'#(lf)      , T1.ITEMCODE 'Codigo Articulo'#(lf)      , T1.DSCRIPTION 'Descripcion de Articulo'#(lf)      , T1.QUANTITY 'Cantidad'#(lf)      ,(T1.[PriceBefDi]*t0.DocRate) 'Precio de venta'#(lf)      ,T1.DiscPrcnt '% Descuento'#(lf)      ,(T1.Price*t0.DocRate) 'Precio tras el descuento'#(lf)      , T1.LINETOTAL 'Valor Total'#(lf)      , T1.GROSSBUYPR AS Costo#(lf), T1.Quantity * t1.GrossBuyPr as 'Costo total'#(lf), t1.LineTotal - (T1.Quantity * t1.GrossBuyPr) as 'Utilidad Bruta'#(lf), (t1.LineTotal - (T1.Quantity * t1.GrossBuyPr)) / t1.LineTotal as 'Margen Bruta'#(lf)      , T3.NAME AS 'Obra'#(lf)      , T16.CityS as 'Ciudad'#(lf)      , T4.Phone1 as 'Teléfono'#(lf)      , t14.U_FNovedad as 'Fecha Fin Novedad'#(lf)      ,T17.Name as 'Segmento del cliente'#(lf)FROM OINV T0#(lf)     INNER JOIN INV1 T1 ON T0.DOCENTRY = T1.DOCENTRY#(lf)     INNER JOIN INV12 T16 ON T0.DOCENTRY = T16.DOCENTRY#(lf)     INNER JOIN OCRD T4 ON T0.CARDCODE = T4.CARDCODE#(lf)     LEFT JOIN OCPR T3 ON T0.CNTCTCODE = T3.CNTCTCODE#(lf)     INNER JOIN OTER T9 ON T4.TERRITORY = T9.TERRITRYID#(lf)     INNER JOIN OCRG T5 ON T4.GROUPCODE = T5.GROUPCODE#(lf)     INNER JOIN OSLP T6 ON T0.SLPCODE = T6.SLPCODE#(lf)     LEFT JOIN OSLP T11 ON T0.SLPCODE = T11.SLPCODE#(lf)     INNER JOIN [@FIR_SUBGRUPOCLIENTE] T8 ON T4.U_SUBGROUPCODE = T8.CODE#(lf)     INNER JOIN OTER T10 ON T9.PARENT = T10.TERRITRYID#(lf)     LEFT JOIN [@FIR_VENDEDORJUNIOR] T12 ON T4.U_VENDEDORJUNIOR = T12.CODE#(lf)     LEFT JOIN OCRD T13 ON T1.U_TIENDAS = T13.CARDCODE#(lf)     LEFT JOIN OITM T14 ON T1.ITEMCODE = T14.ITEMCODE#(lf)     LEFT JOIN OITB T15 ON T14.ITMSGRPCOD = T15.ITMSGRPCOD#(lf)     LEFT JOIN [dbo].[@FIR_SEGMENTACION]  T17 ON T0.[U_Segmentacion] = T17.[Code]#(lf)WHERE T0.SERIES <> '88'#(lf)     AND T0.CANCELED = 'N'#(lf)     AND T1.TAXONLY = 'N'#(lf)     AND T0.U_TipoVentas <> 'Donaciones'#(lf)     AND T1.LINETOTAL <> 0#(lf)     AND T1.ItemCode NOT IN ('VZNOPE-0003-000-0000', 'VZNOPE-0001-000-0000', 'VZNOPE-0004-000-0000', 'VZNOPE-0006-000-0000', #(lf)     'VZNOPE-0007-000-0000', 'VZNOPE-0008-000-0000', 'VZNOPE-0009-000-0000', 'VZNOPE-0010-000-0000', 'VZNOPE-0012-000-0000', #(lf)     'VZNOPE-0014-000-0000', 'VZNOPE-0015-000-0000', 'VZNOPE-0017-000-0000', 'VZNOPE-0018-000-0000', 'VZNOPE-0021-000-0000')#(lf)     AND T0.DocNum NOT IN (96491, 96492, 96493, 96494, 96495, 96496, 96497, 96515, 96516) --Se retira estas facturas por solicitud de Claudia Duque", CreateNavigationProperties=false]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"U_TipoVentas", "TipoVentas"}, {"DOCDATE", "Fecha contabilización"}, {"DOCNUM", "Num Documento"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table

