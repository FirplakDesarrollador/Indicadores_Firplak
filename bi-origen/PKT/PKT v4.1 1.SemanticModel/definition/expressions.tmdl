expression CostosPTNivel1 =
		let
		    Origen = Sql.Database("ITPLAKINFO", "Planos_Symphony", [Query="Select #(lf)t0.Codigo 'Codigo Articulo', #(lf)t0.Descripcion,#(lf)t0.Nivel, #(lf)t0.Cantidad, #(lf)t0.Costo_Unitario, #(lf)t0.Costo_Mp, #(lf)t0.Costo_Mo, #(lf)t0.Costo_Cif, #(lf)t0.Costo_Total#(lf)From Planos_Symphony.dbo.CostosGlobal t0#(lf)where nivel =1#(lf)Order By t0.linea"])
