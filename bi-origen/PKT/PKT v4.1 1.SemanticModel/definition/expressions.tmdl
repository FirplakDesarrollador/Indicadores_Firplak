expression Cap_Trab_2020 =
		let
		    Origen = Sql.Database("ITPLAKINFO", "Firplak_SA", [Query="IF OBJECT_ID('tempdb..#T') IS NOT NULL#(lf)BEGIN#(lf)DROP TABLE #T#(lf)END#(lf)#(lf)Declare#(lf)@FecIni as date,#(lf)@FecFin as date,#(lf)@Year as nvarchar(4),#(lf)@Mes as nvarchar(2)#(lf)#(lf)Set @Mes = 1#(lf)Set @Year = '2020'#(lf)#(lf)Set @FecIni = '01/01/' + @Year#(lf)Set @FecFin = '31/12/' + @Year#(lf)Create Table #T#(lf)(#(lf)Lvl1 nvarchar(16) Collate SQL_Latin1_General_CP850_CI_AS,#(lf)Lvl2 nvarchar(2) Collate SQL_Latin1_General_CP850_CI_AS,#(lf)Lvl3 nvarchar(4) Collate SQL_Latin1_General_CP850_CI_AS,#(lf)Lvl4 nvarchar(6) Collate SQL_Latin1_General_CP850_CI_AS,#(lf)Account nvarchar(8) Collate SQL_Latin1_General_CP850_CI_AS,#(lf)AcctName nvarchar(100) Collate SQL_Latin1_General_CP850_CI_AS,#(lf)[Saldo Inicial] numeric(18,2),#(lf)Débito numeric(18,2),#(lf)Crédito numeric(18,2),#(lf)[Saldo del Mes] numeric(18,2),#(lf)Mes nvarchar(22) Collate SQL_Latin1_General_CP850_CI_AS#(lf))#(lf)Carga_CuentasxMes:#(lf)Insert Into #T (Lvl1,Lvl2,Lvl3,Lvl4,Account,AcctName,[Saldo Inicial],Débito,Crédito,[Saldo del Mes],Mes)#(lf)Select#(lf)SUBSTRING(TA.AcctCode,1,1)+REPLICATE(0,14) Lvl1,#(lf)SUBSTRING(TA.AcctCode,1,2) Lvl2,#(lf)SUBSTRING(TA.AcctCode,1,4) Lvl3,#(lf)SUBSTRING(TA.AcctCode,1,6) Lvl4,#(lf)TA.AcctCode,#(lf)TA.AcctName,#(lf)0,#(lf)0,#(lf)0,#(lf)0,#(lf)@Mes#(lf)from#(lf)OACT TA#(lf)Where#(lf)TA.Levels = 5#(lf)AND TA.Postable = 'Y'#(lf)AND LEN(TA.AcctCode)=8#(lf)Order By TA.AcctCode ASC#(lf)IF @Mes <> 12#(lf)BEGIN set @Mes = @Mes+1 GOTO Carga_CuentasxMes#(lf)END#(lf)Declare#(lf)@Acct as nvarchar(14),#(lf)@Vlr as numeric(18,2),#(lf)@Dbt as numeric(18,2),#(lf)@Crt as numeric(18,2),#(lf)@SldM as numeric(18,2),#(lf)@MesR as nvarchar(2)#(lf)#(lf)Declare CMov CURSOR FOR#(lf)select#(lf)TB.Account,#(lf)isnull(sum(TB.Debit),0),#(lf)isnull(sum(TB.Credit),0),#(lf)isnull((SUM(TB.Debit-Credit)),0),#(lf)MONTH(TB.RefDate) Mes#(lf)from#(lf)JDT1 TB Inner Join#(lf)OJDT TA on TB.TransId = TA.TransId Inner Join#(lf)OACT TC on TB