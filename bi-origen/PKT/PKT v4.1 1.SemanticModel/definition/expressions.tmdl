expression NotasCredito =
		let
		    Origen = Sql.Database("ITPLAKINFO", "Firplak_SA", [Query="SELECT T0.DOCDATE#(lf)      , T0.DOCNUM#(lf)      , CASE#(lf)           WHEN ISNULL( DATALENGTH( T1.U_TIENDAS ),0 ) = 0 THEN T11.SLPNAME#(lf)           ELSE#(lf)               (#(lf)                 SELECT VENDEDOR.SLPNAME#(lf)     FROM OSLP VENDEDOR#(lf)          INNER JOIN OCRD SN ON SN.SLPCODE = VENDEDOR.SLPCODE#(lf)     WHERE SN.CARDCODE = T1.U_TIENDAS#(lf)               )#(lf)       END AS 'Vendedor Senior'#(lf)      , CASE#(lf)           WHEN ISNULL( DATALENGTH( T1.U_TIENDAS ),0 ) = 0 THEN T12.NAME#(lf)           ELSE#(lf)               (#(lf)                 SELECT DISTINCT#(lf)          T16.NAME#(lf)     FROM [@FIR_VENDEDORJUNIOR] T16#(lf)          INNER JOIN OCRD T17 ON T17.U_VENDEDORJUNIOR = T16.CODE#(lf)     WHERE T17.CARDCODE = T1.U_TIENDAS#(lf)               )#(lf)       END AS 'Vendedor Junior'#(lf)      , T0.U_TipoVentas#(lf)      , CASE#(lf)           WHEN ISNULL( DATALENGTH( T1.U_TIENDAS ),0 ) = 0 THEN T10.DESCRIPT#(lf)           ELSE#(lf)               (#(lf)                 SELECT ZONAPADRE.DESCRIPT#(lf)     FROM OCRD ZONASN#(lf)          INNER JOIN OTER ZONATERRITORIO ON ZONASN.TERRITORY = ZONATERRITORIO.TERRITRYID#(lf)          INNER JOIN OTER ZONAPADRE ON ZONATERRITORIO.PARENT = ZONAPADRE.TERRITRYID#(lf)     WHERE ZONASN.CARDCODE = T1.U_TIENDAS#(lf)               )#(lf)       END AS 'Zona'#(lf)      , CASE#(lf)           WHEN ISNULL( DATALENGTH( T1.U_TIENDAS ),0 ) = 0 THEN T9.DESCRIPT#(lf)           ELSE#(lf)               (#(lf)                 SELECT ZONATERRITORIO.DESCRIPT#(lf)     FROM OCRD ZONASN#(lf)          INNER JOIN OTER ZONATERRITORIO ON ZONASN.TERRITORY = ZONATERRITORIO.TERRITRYID#(lf)     WHERE ZONASN.CARDCODE = T1.U_TIENDAS#(lf)               )#(lf)       END AS 'Territorio'#(lf)      , T5.GROUPNAME 'Grupo de Cliente'#(lf)      , T8.NAME 'Subgrupo de Cliente'#(lf)      , T0.CARDCODE 'Cod Cliente'#(lf)      , T0.CARDNAME 'Nombre Cliente'#(lf)      , T1.U_TIENDAS 'Código Punto de Venta'#(lf)      , T13.CARDNAME 'Descripción Punto de Venta'#(lf)      , CASE#(lf)           WHEN ISNULL( DATALENGTH( T1.U_TIENDAS ),0 ) = 0 THEN T4.U_CENTRODECTOS#(lf)           ELSE T13.U_CENTRODECTOS#(lf)       END AS 'Centro de Costos'#(lf)      , T15.ITMSGRPNAM 'Grupo de Articulo'#(lf)      , T14.U_GRUPO 'Familia'#(lf)      , T1.ITEMCODE 'Codigo Articulo'#(lf)      , T1.DSCRIPTION 'Descripcion de Articulo'#(lf)      , case WHEN t1.itemcode = 'VZNOPE-0011-000-0000' THEN '0' else T1.QUANTITY * -1 END AS 'Cantidad'#(lf)      ,(T1.[PriceBefDi]*t0.DocRate) 'Precio de venta'#(lf)      ,T1.DiscPrcnt '% Descuento'#(lf)      ,(T1.Price*t0.DocRate) 'Precio tras el descuento'#(lf)     , T1.LINETOTAL * -1 'Valor Total'      #(lf)     , T1.GROSSBUYPR AS Costo#(lf)#(tab)  , T1.Quantity * t1.GrossBuyPr*-1 as 'Costo total'#(lf)#(tab), (t1.LineTotal)*-1 - (T1.Quantity * t1.GrossBuyPr*-1) as 'Utilidad Bruta'#(lf)#(tab), 0.00 as 'Margen Bruta'#(lf)--((t1.LineTotal)*-1 - (T1.Quantity * t1.GrossBuyPr*-1)) / t1.LineTotal#(lf)      , T3.NAME AS 'Obra'#(lf)#(tab)  , T16.CityS as 'Ciudad'#(lf)      , T4.Phone1 as 'Teléfono'#(lf)#(tab), t14.U_FNovedad as 'Fecha Fin Novedad'#(lf)      ,T17.Name as 'Segmento del cliente'#(lf)      , T0.U_TIPOSNC 'Codigo del Tipo NC'#(lf)      , T30.NAME 'TiposNC'#(lf)      , T1.U_CONCEPTOSNC 'Codigo Concepto Nc'#(lf)      , T31.NAME 'Conceptos Notas Crédito'#(lf)      , T0.COMMENTS#(lf)FROM ORIN T0#(lf)     INNER JOIN RIN1 T1 ON T0.DOCENTRY = T1.DOCENTRY#(lf)     INNER JOIN RIN12 T16 ON T0.DOCENTRY = T16.DOCENTRY#(lf)     INNER JOIN OCRD T4 ON T0.CARDCODE = T4.CARDCODE#(lf)     LEFT JOIN OCPR T3 ON T0.CNTCTCODE = T3.CNTCTCODE#(lf)     INNER JOIN OTER T9 ON T4.TERRITORY = T9.TERRITRYID#(lf)     INNER JOIN OCRG T5 ON T4.GROUPCODE = T5.GROUPCODE#(lf)     INNER JOIN OSLP T6 ON T0.SLPCODE = T6.SLPCODE#(lf)     LEFT JOIN OSLP T11 ON T0.SLPCODE = T11.SLPCODE#(lf)     LEFT JOIN [@FIR_SUBGRUPOCLIENTE] T8 ON T4.U_SUBGROUPCODE = T8.CODE#(lf)     LEFT JOIN OTER T10 ON T9.PARENT = T10.TERRITRYID#(lf)     LEFT JOIN [@FIR_VENDEDORJUNIOR] T12 ON T4.U_VENDEDORJUNIOR = T12.CODE#(lf)     LEFT JOIN OCRD T13 ON T1.U_TIENDAS = T13.CARDCODE#(lf)     LEFT JOIN OITM T14 ON T1.ITEMCODE = T14.ITEMCODE#(lf)     LEFT JOIN OITB T15 ON T14.ITMSGRPCOD = T15.ITMSGRPCOD#(lf)     LEFT JOIN [@FIR_TIPOSNC] T30 ON T0.U_TIPOSNC = T30.CODE#(lf)     LEFT JOIN [@FIR_CONCEPTOSNC] T31 ON T1.U_CONCEPTOSNC = T31.CODE#(lf)     LEFT JOIN [dbo].[@FIR_SEGMENTACION]  T17 ON T0.[U_Segmentacion] = T17.[Code]#(lf)WHERE T0.SERIES <> '88'#(lf)     AND T1.TAXONLY = 'N'#(lf)     AND T1.LINETOTAL <> 0#(lf)     AND T0.CANCELED = 'N'#(lf)     And t0.DocType <>'S'#(lf)     AND T0.U_TipoVentas <> 'Donaciones'#(lf)     AND T1.ItemCode NOT IN ('VZNOPE-0003-000-0000', 'VZNOPE-0001-000-0000', 'VZNOPE-0004-000-0000', 'VZNOPE-0006-000-0000', #(lf)     'VZNOPE-0007-000-0000', 'VZNOPE-0008-000-0000', 'VZNOPE-0009-000-0000', 'VZNOPE-0010-000-0000', 'VZNOPE-0012-000-0000', #(lf)     'VZNOPE-0014-000-0000', 'VZNOPE-0015-000-0000', 'VZNOPE-0017-000-0000', 'VZNOPE-0018-000-0000', 'VZNOPE-0021-000-0000', #(lf)     'VZNOPE-0023-000-0000', 'VZNOPE-0024-000-0000')#(lf)     AND T0.DocNum <> 1002414 --Se retira esta NC por solicitud de Claudia Duque"]),
		    #"Renamed Columns" = Table.RenameColumns(Origen,{{"U_TipoVentas", "TipoVentas"}, {"DOCDATE", "Fecha contabilización"}, {"DOCNUM", "Num Documento"}, {"COMMENTS", "Comentarios"}})
		in
		    #"Renamed Columns"
