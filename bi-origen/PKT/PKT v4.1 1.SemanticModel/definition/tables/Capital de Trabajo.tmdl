table 'Capital de Trabajo'
	lineageTag: 52adf279-0fa8-44ab-926b-776595257d62

	measure 'Anticipos de impuestos o saldos a favor' = CALCULATE(MAX(CapitalTrabajo[Saldo Final]), CapitalTrabajo[Lvl3] = 1355, ISBLANK(CapitalTrabajo[Lvl4]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Anticipos de impuestos o saldos a favor
		lineageTag: f16a84dd-7285-47e8-9d2e-a1ce9b1d9a0a

	measure Clientes = ```
			CALCULATE(MAX(CapitalTrabajo[Saldo Final]), CapitalTrabajo[Account] = 13050505) 
			            + CALCULATE(MAX(CapitalTrabajo[Saldo Final]), CapitalTrabajo[Account] = 13051005) 
			            + CALCULATE(MAX(CapitalTrabajo[Saldo Final]), CapitalTrabajo[Account] = 13051010)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Clientes
		lineageTag: 5f4bd13f-ede6-447e-b156-93e6dffe2d51

	measure Inventarios = CALCULATE(MAX(CapitalTrabajo[Saldo Final]), CapitalTrabajo[Lvl2] = 14, ISBLANK(CapitalTrabajo[Lvl3]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Inventarios
		lineageTag: d90182d3-4dad-4c7d-8be2-bb72d2b0795b

	measure 'Otras cuentas por cobrar operativas' = (CALCULATE(MAX(CapitalTrabajo[Saldo Final]),CapitalTrabajo[Lvl3] = 1330, ISBLANK(CapitalTrabajo[Lvl4])) - CALCULATE(MAX(CapitalTrabajo[Saldo Final]),CapitalTrabajo[Account] = 13300515)) + CALCULATE(MAX(CapitalTrabajo[Saldo Final]),CapitalTrabajo[Lvl3] = 1365, ISBLANK(CapitalTrabajo[Lvl4]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Otras cuentas por cobrar operativas
		lineageTag: 9fc115c9-2971-47a3-b904-ee21d5e5e4cd

	measure 'Provisión (Deterioro) CxC (Vr. negativo)' = CALCULATE(MAX(CapitalTrabajo[Saldo Final]),CapitalTrabajo[Account] = 13050590) + CALCULATE(MAX(CapitalTrabajo[Saldo Final]),CapitalTrabajo[Account] = 13051090) + CALCULATE(MAX(CapitalTrabajo[Saldo Final]), CapitalTrabajo[Lvl4] = 139905, ISBLANK(CapitalTrabajo[Account]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Provisión (Deterioro) CxC (Vr. negativo)
		lineageTag: 39513cf8-be14-438d-b9f1-c59df9f604ca

	measure 'Capital Trabajo' = [Anticipos de impuestos o saldos a favor] + [Clientes] + [Inventarios] + [Otras cuentas por cobrar operativas] + [Provisión (Deterioro) CxC (Vr. negativo)]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Capital de Trabajo
		lineageTag: 95afbea3-e8c5-466e-b673-fb40f9b3b668

	measure 'Label Capital trabajo' = "Capital de Trabajo"
		displayFolder: Capital de Trabajo
