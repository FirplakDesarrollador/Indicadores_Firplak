	measure 'A.A. Capital Trabajo' = CALCULATE([Capital Trabajo], MONTH(Calendario[Fecha]) = 12, YEAR(Calendario[Fecha]) = (SELECTEDVALUE(Calendario[Fecha].[Año])-1))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Capital de Trabajo
		lineageTag: 43453a5b-f1c3-46fd-9da9-3f5cbf4d55ab

