	measure 'Año Anterior' =
			
			IF(HASONEVALUE('NombresMedidas'[Nivel 2]),
			    SWITCH(
			        VALUES('NombresMedidas'[Nivel 2]),
			            "Clientes", [A.A. Clientes],
			            "Inventarios", [A.A. Inventarios],
			            "Anticipos de impuestos o saldos a favor", [A.A Anticipos de impuestos o saldos a favor],
			            "Otras cuentas por cobrar operativas", [A.A. Otras cuentas por cobrar operativas],
			            "Provisión (Deterioro) CxC (Vr. negativo)", [A.A. Provisión (Deterioro) CxC (Vr. negativo)],
			            "Costos y Gastos por pagar", [A.A. Costos y Gastos por pagar],
			            "Impuestos por pagar", [A.A. Impuestos por pagar],
			            "Obligaciones laborales", [A.A. Obligaciones laborales],
			            "Otras cuentas por pagar operativas", [A.A. Otras cuentas por pagar operativas],
			            "Pasivos estimados y provisiones", [A.A. Pasivos estimados y provisiones],
			            "Proveedores", [A.A. Proveedores],
			            "Ob. Fras. Prov. - Confirming",[A.A. Confirming]
			        ),
			IF(HASONEVALUE('NombresMedidas'[Nivel 1]),
			    SWITCH(
			        VALUES('NombresMedidas'[Nivel 1]),
			        "Capital de Trabajo", [A.A. Capital Trabajo],
			        "Proveedores de bienes y servicios", [A.A. Proveedores de bienes y servicios],
			        "z KTNO", [A.A KTNO]
			   )))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 01545ab6-5796-477c-9453-afc2d97bd7e2

	measure 'Año Actual' =
			
			IF(HASONEVALUE('NombresMedidas'[Nivel 2]),
			    SWITCH(
			        VALUES('NombresMedidas'[Nivel 2]),
			            "Clientes", [Clientes],
			            "Inventarios", [Inventarios],
			            "Anticipos de impuestos o saldos a favor", [Anticipos de impuestos o saldos a favor],
			            "Otras cuentas por cobrar operativas", [Otras cuentas por cobrar operativas],
			            "Provisión (Deterioro) CxC (Vr. negativo)", [Provisión (Deterioro) CxC (Vr. negativo)],
			            "Costos y Gastos por pagar", [Costos y Gastos por pagar],
			            "Impuestos por pagar", [Impuestos por pagar],
			            "Obligaciones laborales", [Obligaciones laborales],
			            "Otras cuentas por pagar operativas", [Otras cuentas por pagar operativas],
			            "Pasivos estimados y provisiones", [Pasivos estimados y provisiones],
			            "Proveedores", [Proveedores],
			            "Ob. Fras. Prov. - Confirming", [Confirming]
			        ),
			IF(HASONEVALUE('NombresMedidas'[Nivel 1]),
			    SWITCH(
			        VALUES('NombresMedidas'[Nivel 1]),
			        "Capital de Trabajo", [Capital Trabajo],
			        "Proveedores de bienes y servicios", [Proveedores de bienes y servicios],
			        "z KTNO", [KTNO]
			   )))
		lineageTag: 209d24ad-ce21-4a4d-bf13-a46538af728f

		formatStringDefinition = "\$#,0;(\$#,0);\$#,0"

	measure Variacion = [Año Actual] - [Año Anterior]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: f4fd0843-91f4-4ccf-8d56-42285175a6e6

	measure % = DIVIDE([Variacion], [Año Anterior], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 0f3d4459-f48f-442a-81e2-82d69ecd4e25

	measure Prueba = HASONEVALUE('NombresMedidas'[Nivel 2])
		formatString: """TRUE"";""TRUE"";""FALSE"""
