	column Agrupacion =
			SWITCH(TRUE(),
			CapitalTrabajo[Account] = 13050505 || CapitalTrabajo[Account] = 13051005,"Clientes",
			CapitalTrabajo[Account] = 13050590 || CapitalTrabajo[Account] = 13051090 || CapitalTrabajo[Lvl3]= 1399 && ISBLANK(CapitalTrabajo[Lvl4]),"Provisión (Deterioro) CxC (Vr. negativo)",
			CapitalTrabajo[Lvl3] = 1355 && ISBLANK(CapitalTrabajo[Lvl4]) ,"Anticipo de impuestos o saldos a favor",
			CapitalTrabajo[Account] = 13300505 || CapitalTrabajo[Account] = 13300510 || CapitalTrabajo[Lvl4] = 133015 && ISBLANK(CapitalTrabajo[Account]) || CapitalTrabajo[Lvl3] = 1365 && ISBLANK(CapitalTrabajo[Lvl4]),"Otras cuentas por cobrar operativas",
			CapitalTrabajo[Lvl2] = 14 && ISBLANK(CapitalTrabajo[Lvl3]), "Inventarios",
			CapitalTrabajo[Lvl2] = 22 && ISBLANK(CapitalTrabajo[Lvl3]), "Proveedores",
			//CapitalTrabajo[Lvl1] = 0, "Obligaciones Financieras Proveedores - Factoring",
			CapitalTrabajo[Lvl1] = 4 && ISBLANK(CapitalTrabajo[Lvl2]) || CapitalTrabajo[Lvl1] = 5 && ISBLANK(CapitalTrabajo[Lvl2]) || CapitalTrabajo[Lvl1] = 6 && ISBLANK(CapitalTrabajo[Lvl2]) || CapitalTrabajo[Lvl3] = 9251 && ISBLANK(CapitalTrabajo[Lvl4]) || CapitalTrabajo[Lvl3] = 9253 && ISBLANK(CapitalTrabajo[Lvl4]), "Impuestos por Pagar",
			CapitalTrabajo[Lvl2] = 25 && ISBLANK(CapitalTrabajo[Lvl3]), "Obligaciones Laborales",
			CapitalTrabajo[Lvl3] = 2335 && ISBLANK(CapitalTrabajo[Lvl4]) || CapitalTrabajo[Account] = 23359515, "Costos y gastos por pagar",
			CapitalTrabajo[Lvl2] = 26 && ISBLANK(CapitalTrabajo[Lvl3]), "Pasivos Estimados y Provisiones",
			CapitalTrabajo[Lvl3] = 2365 && ISBLANK(CapitalTrabajo[Lvl4]) || CapitalTrabajo[Lvl3] = 2367 && ISBLANK(CapitalTrabajo[Lvl4])|| CapitalTrabajo[Lvl3] = 2368 && ISBLANK(CapitalTrabajo[Lvl4]) || CapitalTrabajo[Lvl3] = 2370 && ISBLANK(CapitalTrabajo[Lvl4]) || CapitalTrabajo[Lvl3] = 2380 && ISBLANK(CapitalTrabajo[Lvl4]) || CapitalTrabajo[Lvl3] = 2408 && ISBLANK(CapitalTrabajo[Lvl4]) || CapitalTrabajo[Lvl2] = 28 && ISBLANK(CapitalTrabajo[Lvl3]), "Otras cuentas por pagar operativas"
			)
		lineageTag: a153eef3-bb08-4158-919a-64a29d5413b5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Agrupacion 2' =
			SWITCH(TRUE(),
			CapitalTrabajo[Agrupacion] = "Clientes" || CapitalTrabajo[Agrupacion] = "Provisión (Deterioro) CxC (Vr. negativo)" || CapitalTrabajo[Agrupacion]= "Anticipo de impuestos o saldos a favor" || CapitalTrabajo[Agrupacion] = "Otras cuentas por cobrar operativas" || CapitalTrabajo[Agrupacion]= "Inventarios", "CAPITAL TRABAJO OPERATIVO",
			CapitalTrabajo[Agrupacion] = "Proveedores" || CapitalTrabajo[Agrupacion] = "Obligaciones Financieras Proveedores - Factoring" || CapitalTrabajo[Agrupacion] = "Impuestos por pagar" || CapitalTrabajo[Agrupacion] = "Obligaciones Laborales" || CapitalTrabajo[Agrupacion] = "Costos y gastos por pagar" || CapitalTrabajo[Agrupacion] = "Pasivos Estimados y Provisiones" || CapitalTrabajo[Agrupacion] = "Otras cuentas por pagar operativas", "PROVEEDORES DE BIENES Y SERVICIOS (PBS)"
			)
