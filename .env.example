# SQL Server: nunca expongas estas variables con el prefijo NEXT_PUBLIC_
SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_ENCRYPT=true
SQL_SERVER_TRUST_CERTIFICATE=false
SQL_SERVER_FACTURACION_VIEW=Planos_Symphony.bi.vw_InformeVentas

# API independiente instalada junto al SQL Server de informes.
# Si se configura, Next.js la consume server-to-server y no usa SQL Server desde Vercel.
REPORTING_API_URL=https://api.firplak.com
REPORTING_API_TOKEN=
