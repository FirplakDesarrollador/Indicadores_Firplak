# Puerto local del servicio. IIS puede publicar HTTPS y reenviar aquí.
PORT=8080

# SQL Server de informes. No es la base de datos transaccional de SAP.
REPORT_DB_SERVER=
REPORT_DB_PORT=1433
REPORT_DB_INSTANCE_NAME=
REPORT_DB_NAME=Planos_Symphony
REPORT_DB_USER=
REPORT_DB_PASSWORD=
REPORT_DB_ENCRYPT=false
REPORT_DB_TRUST_SERVER_CERTIFICATE=true
REPORT_DB_CONNECTION_TIMEOUT_MS=30000
REPORT_DB_REQUEST_TIMEOUT_MS=60000
REPORT_DB_TABLE_SCHEMA=dbo
REPORT_DB_TABLE=Informe_ventas

# La vista entregada está en [Planos_Symphony].[bi].[vw_InformeVentas].
REPORT_DB_VIEW_SCHEMA=bi
REPORT_DB_VIEW=vw_InformeVentas

# Token exclusivo para la comunicación Vercel -> API. Nunca va al navegador.
REPORTING_API_TOKEN=

# Límite para evitar consultas demasiado grandes.
REPORTING_MAX_PAGE_SIZE=1000
